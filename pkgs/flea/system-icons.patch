+#[test]
+fn carry_wire_roundtrip_keeps_exact_theme_names_and_language_fallbacks() {
+    let mut offer = offer();
+    offer.flock.marks = vec![
+        Mark::for_icon("application-pdf", 0o100644),
+        Mark::for_file("main.rs", false, 0o100644, "text-x-rust", true),
+    ];
+    let decoded = Offer::decode(&offer.encode()).unwrap();
+    assert_eq!(decoded, offer);
+    assert_eq!(
+        &*decoded.flock.marks[0].themed_icon().unwrap(),
+        "application-pdf"
+    );
+    assert_eq!(
+        &*decoded.flock.marks[1].themed_icon().unwrap(),
+        "text-x-rust"
+    );
+    assert!(matches!(
+        decoded.flock.marks[1].fallback(),
+        Mark::Language(_)
+    ));
+}
