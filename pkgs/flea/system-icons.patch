+use super::*;
+use std::{path::PathBuf, sync::atomic::Ordering};
+
+struct Theme {
+    root: PathBuf,
+    icons: Icons,
+}
+impl Theme {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let root = std::env::temp_dir().join(format!(
+            "flea-system-icons-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir_all(root.join("Yaru-sage-dark")).unwrap();
+        std::fs::create_dir_all(root.join("Parent/scalable/mimetypes")).unwrap();
+        std::fs::write(
+            root.join("Yaru-sage-dark/index.theme"),
+            "[Icon Theme]\nInherits=Parent\n",
+        )
+        .unwrap();
+        std::fs::write(root.join("Parent/index.theme"),
+            "[Icon Theme]\nDirectories=scalable/mimetypes\n[scalable/mimetypes]\nSize=32\nType=Scalable\nMinSize=16\nMaxSize=256\n").unwrap();
+        let icons = Icons {
+            theme: "Yaru-sage-dark".into(),
+            bases: vec![root.clone()],
+            pixmaps: Vec::new(),
+        };
+        Self { root, icons }
+    }
+    fn write(&self, name: &str, data: &[u8]) {
+        std::fs::write(self.root.join("Parent/scalable/mimetypes").join(name), data).unwrap();
+    }
+    fn load(&self, name: &str, alpha: u8) -> Option<Arc<RenderImage>> {
+        load(
+            &self.icons,
