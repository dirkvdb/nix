+#[test]
+fn specific_icon_beats_generic_and_invalid_theme_still_has_builtin_fallback() {
+    let theme = Theme::new();
+    theme.write("application-pdf.svg", COLOUR);
+    theme.write("application-x-generic.svg", b"broken generic");
+    assert!(theme.load("application-pdf", 255).is_some());
+    std::fs::write(theme.root.join("Parent/index.theme"), "not an icon theme").unwrap();
+    assert!(theme.load("application-pdf", 255).is_none());
+    assert_eq!(
+        Mark::for_icon("application-pdf", 0o100644).svg(),
+        Mark::File.svg()
+    );
+}
+
+#[test]
+fn requests_and_negative_results_are_cached_and_pending_work_is_never_duplicated() {
+    let mut cache = Cache::default();
+    let wanted = key("folder", 255);
+    assert!(cache.request(&wanted).1);
+    assert!(!cache.request(&wanted).1);
+    cache.finish(wanted.clone(), None);
+    let (raster, fresh) = cache.request(&wanted);
+    assert!(matches!(raster, Raster::Missing));
+    assert!(
+        !fresh,
+        "a missing icon must not cause disk work on every frame"
+    );
+    let image = Arc::new(RenderImage::from_bgra(1, 1, vec![0, 0, 255, 255]).unwrap());
+    cache.finish(wanted.clone(), Some(Arc::clone(&image)));
+    let (raster, fresh) = cache.request(&wanted);
+    let Raster::Ready(held) = raster else {
+        panic!("completed raster lost")
+    };
+    assert!(Arc::ptr_eq(&held, &image));
+    assert!(!fresh);
+    assert!(
+        cache.request(&key("folder", 102)).1,
+        "cut opacity has its own raster"
+    );
+    let mut bigger = wanted.clone();
+    bigger.side = 64;
+    assert!(
+        cache.request(&bigger).1,
+        "HiDPI and Grid need size-specific rasters"
+    );
+}
+
+#[test]
+fn raster_cache_is_bounded_and_only_completed_entries_can_be_evicted() {
+    let mut cache = Cache::default();
+    for n in 0..MAX_RASTERS {
+        assert!(cache.request(&key(&format!("icon-{n}"), 255)).1);
+    }
+    let overflow = key("overflow", 255);
+    assert!(!cache.request(&overflow).1);
+    assert_eq!(cache.entries.len(), MAX_RASTERS);
+    cache.finish(key("icon-0", 255), None);
+    assert!(cache.request(&overflow).1);
+    assert!(!cache.entries.contains_key(&key("icon-0", 255)));
+    assert!(!cache.request(&key("icon-1", 255)).1);
+    assert_eq!(cache.entries.len(), MAX_RASTERS);
+}
