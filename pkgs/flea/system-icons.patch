+#[test]
+fn inherited_svg_keeps_rgb_and_cut_opacity_does_not_tint_it() {
+    let theme = Theme::new();
+    theme.write("text-x-rust.svg", COLOUR);
+    let mark = Mark::for_file("main.rs", false, 0o100644, "text-x-rust", true);
+    let normal = theme.load(&identity(mark).0, 255).unwrap();
+    let cut = theme.load("text-x-rust", 102).unwrap();
+    for (x, bgra) in [(8, [0, 0, 255, 255]), (24, [0, 255, 0, 255])] {
+        let at = (16 * 32 + x) * 4;
+        assert_eq!(&normal.as_bytes(0).unwrap()[at..at + 4], &bgra);
+        assert_eq!(&cut.as_bytes(0).unwrap()[at..at + 3], &bgra[..3]);
+        assert_eq!(cut.as_bytes(0).unwrap()[at + 3], 102);
+    }
+}
