+use super::*;
+use std::{path::PathBuf, sync::atomic::Ordering};
+
+struct Theme {
+    root: PathBuf,
+    icons: Icons,
+}
+impl Theme {
+    fn new() -> Self {
+        static NEXT: AtomicU64 = AtomicU64::new(0);
+        let root = std::env::temp_dir().join(format!(
+            "flea-system-icons-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        std::fs::create_dir_all(root.join("Yaru-sage-dark")).unwrap();
+        std::fs::create_dir_all(root.join("Parent/scalable/mimetypes")).unwrap();
+        std::fs::write(
+            root.join("Yaru-sage-dark/index.theme"),
+            "[Icon Theme]\nInherits=Parent\n",
+        )
+        .unwrap();
+        std::fs::write(root.join("Parent/index.theme"),
+            "[Icon Theme]\nDirectories=scalable/mimetypes\n[scalable/mimetypes]\nSize=32\nType=Scalable\nMinSize=16\nMaxSize=256\n").unwrap();
+        let icons = Icons {
+            theme: "Yaru-sage-dark".into(),
+            bases: vec![root.clone()],
+            pixmaps: Vec::new(),
+        };
+        Self { root, icons }
+    }
+    fn write(&self, name: &str, data: &[u8]) {
+        std::fs::write(self.root.join("Parent/scalable/mimetypes").join(name), data).unwrap();
+    }
+    fn load(&self, name: &str, alpha: u8) -> Option<Arc<RenderImage>> {
+        load(
+            &self.icons,
+            &key(name, alpha),
+            SvgRenderer::new(Arc::new(())),
+        )
+    }
+}
+impl Drop for Theme {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+fn key(name: &str, alpha: u8) -> Key {
+    Key {
+        name: Arc::from(name),
+        side: 32,
+        alpha,
+    }
+}
+const COLOUR: &[u8] = br##"<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32"><path fill="#ff0000" d="M0 0h16v32H0z"/><path fill="#00ff00" d="M16 0h16v32H16z"/></svg>"##;
+
+#[test]
+fn exact_mime_names_survive_copy_marks_and_language_logos_are_only_fallbacks() {
+    assert_eq!(&*identity(Mark::FolderOpen).0, "folder-open");
+    assert_eq!(Mark::FolderOpen.fallback(), Mark::FolderOpen);
+    let pdf = Mark::for_icon("application-pdf", 0o100644);
+    let source = Mark::for_file("main.rs", false, 0o100644, "text-x-rust", true);
+    assert_eq!(&*identity(pdf).0, "application-pdf");
+    assert_eq!(pdf.fallback(), Mark::File);
+    assert_eq!(&*identity(source).0, "text-x-rust");
+    assert!(matches!(source.fallback(), Mark::Language(_)));
+    assert_eq!(
+        source,
+        Mark::for_file("main.rs", false, 0o100644, "text-x-rust", true)
+    );
+    assert_eq!(source.svg(), source.fallback().svg());
+    let link = Mark::for_file("main.rs", false, 0o120777, "text-x-rust", true);
+    assert_eq!(link.fallback(), Mark::Symlink);
+    assert_eq!(
+        &*identity(Mark::for_file("d", true, 0o040755, "", true)).0,
+        "folder"
+    );
+    for unsafe_name in ["/tmp/icon.svg", "../icon", "..", "a\0b"] {
+        assert_eq!(Mark::for_icon(unsafe_name, 0o100644), Mark::File);
+    }
+}
+
+#[test]
+fn inherited_svg_keeps_rgb_and_cut_opacity_does_not_tint_it() {
+    let theme = Theme::new();
+    theme.write("text-x-rust.svg", COLOUR);
+    let mark = Mark::for_file("main.rs", false, 0o100644, "text-x-rust", true);
+    let normal = theme.load(&identity(mark).0, 255).unwrap();
+    let cut = theme.load("text-x-rust", 102).unwrap();
+    for (x, bgra) in [(8, [0, 0, 255, 255]), (24, [0, 255, 0, 255])] {
+        let at = (16 * 32 + x) * 4;
+        assert_eq!(&normal.as_bytes(0).unwrap()[at..at + 4], &bgra);
+        assert_eq!(&cut.as_bytes(0).unwrap()[at..at + 3], &bgra[..3]);
+        assert_eq!(cut.as_bytes(0).unwrap()[at + 3], 102);
+    }
+}
+
+#[test]
+fn png_is_full_colour_and_malformed_specific_svg_can_use_generic_theme_icon() {
+    let theme = Theme::new();
+    let path = theme
+        .root
+        .join("Parent/scalable/mimetypes/text-x-generic.png");
+    image::RgbaImage::from_pixel(32, 32, image::Rgba([32, 160, 240, 255]))
+        .save_with_format(path, image::ImageFormat::Png)
+        .unwrap();
+    theme.write("text-x-rust.svg", b"not an SVG");
+    let image = theme.load("text-x-rust", 255).unwrap();
+    assert_eq!(&image.as_bytes(0).unwrap()[0..4], &[240, 160, 32, 255]);
+    assert!(theme.load("folder", 255).is_none());
+    theme.write("folder.svg", b"<svg broken");
+    assert!(theme.load("folder", 255).is_none());
+    // Missing/malformed assets leave exactly the old built-in available to the painter.
+    let folder = Mark::for_icon("folder", 0o040755);
+    assert_eq!(folder.svg(), Mark::Folder.svg());
+}
+
+#[test]
+fn specific_icon_beats_generic_and_invalid_theme_still_has_builtin_fallback() {
+    let theme = Theme::new();
+    theme.write("application-pdf.svg", COLOUR);
+    theme.write("application-x-generic.svg", b"broken generic");
+    assert!(theme.load("application-pdf", 255).is_some());
+    std::fs::write(theme.root.join("Parent/index.theme"), "not an icon theme").unwrap();
+    assert!(theme.load("application-pdf", 255).is_none());
+    assert_eq!(
+        Mark::for_icon("application-pdf", 0o100644).svg(),
+        Mark::File.svg()
+    );
+}
+
+#[test]
+fn requests_and_negative_results_are_cached_and_pending_work_is_never_duplicated() {
+    let mut cache = Cache::default();
+    let wanted = key("folder", 255);
+    assert!(cache.request(&wanted).1);
+    assert!(!cache.request(&wanted).1);
+    cache.finish(wanted.clone(), None);
+    let (raster, fresh) = cache.request(&wanted);
+    assert!(matches!(raster, Raster::Missing));
+    assert!(
+        !fresh,
+        "a missing icon must not cause disk work on every frame"
+    );
+    let image = Arc::new(RenderImage::from_bgra(1, 1, vec![0, 0, 255, 255]).unwrap());
+    cache.finish(wanted.clone(), Some(Arc::clone(&image)));
+    let (raster, fresh) = cache.request(&wanted);
+    let Raster::Ready(held) = raster else {
+        panic!("completed raster lost")
+    };
+    assert!(Arc::ptr_eq(&held, &image));
+    assert!(!fresh);
+    assert!(
+        cache.request(&key("folder", 102)).1,
+        "cut opacity has its own raster"
+    );
+    let mut bigger = wanted.clone();
+    bigger.side = 64;
+    assert!(
+        cache.request(&bigger).1,
+        "HiDPI and Grid need size-specific rasters"
+    );
+}
+
+#[test]
+fn raster_cache_is_bounded_and_only_completed_entries_can_be_evicted() {
+    let mut cache = Cache::default();
+    for n in 0..MAX_RASTERS {
+        assert!(cache.request(&key(&format!("icon-{n}"), 255)).1);
+    }
+    let overflow = key("overflow", 255);
+    assert!(!cache.request(&overflow).1);
+    assert_eq!(cache.entries.len(), MAX_RASTERS);
+    cache.finish(key("icon-0", 255), None);
+    assert!(cache.request(&overflow).1);
+    assert!(!cache.entries.contains_key(&key("icon-0", 255)));
+    assert!(!cache.request(&key("icon-1", 255)).1);
+    assert_eq!(cache.entries.len(), MAX_RASTERS);
+}
