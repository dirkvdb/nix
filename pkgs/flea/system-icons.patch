new file mode 100644
--- /dev/null
+++ b/crates/flea-gui/src/row/marks/system_icons.rs
@@ -0,0 +1,237 @@
+//! Session file icons. Selection and painting do no filesystem work; even misses are cached.
+use super::Mark;
+use crate::g2::pv1;
+use flea::ui_logic_op3::openwith::icons::Icons;
+use gpui::{App, Bounds, Corners, Pixels, RenderImage, SvgRenderer, Window};
+use std::{
+    collections::HashMap,
+    sync::{atomic::AtomicU64, Arc, Mutex, OnceLock},
+};
+
+const MAX_NAMES: usize = 1024;
+const MAX_RASTERS: usize = 128;
+
+type Identity = (Arc<str>, Mark);
+#[derive(Default)]
+struct Names {
+    ids: HashMap<(String, Mark), u16>,
+    entries: Vec<Identity>,
+}
+fn names() -> &'static Mutex<Names> {
+    static NAMES: OnceLock<Mutex<Names>> = OnceLock::new();
+    NAMES.get_or_init(Default::default)
+}
+
+pub(super) fn intern(name: &str, fallback: Mark) -> Mark {
+    // Row icon names are theme components, never paths supplied by a remote listing.
+    if name.is_empty()
+        || name.len() > 255
+        || name.contains(['/', '\0'])
+        || matches!(name, "." | "..")
+    {
+        return fallback;
+    }
+    let mut names = names().lock().unwrap();
+    let key = (name.to_owned(), fallback);
+    if let Some(id) = names.ids.get(&key) {
+        return Mark::Themed(*id);
+    }
+    if names.entries.len() >= MAX_NAMES {
+        return fallback;
+    }
+    let id = names.entries.len() as u16;
+    names.entries.push((Arc::from(name), fallback));
+    names.ids.insert(key, id);
+    Mark::Themed(id)
+}
+
+pub(super) fn identity(mark: Mark) -> Identity {
+    if let Mark::Themed(id) = mark {
+        return names()
+            .lock()
+            .unwrap()
+            .entries
+            .get(id as usize)
+            .cloned()
+            .unwrap_or_else(|| (Arc::from(""), Mark::File));
+    }
+    let name = match mark {
+        Mark::Folder => "folder",
+        Mark::File => "application-octet-stream",
+        Mark::FileText => "text-x-generic",
+        Mark::Code | Mark::Language(_) => "text-x-script",
+        Mark::Image => "image-x-generic",
+        Mark::Film => "video-x-generic",
+        Mark::Music => "audio-x-generic",
+        Mark::Archive => "package-x-generic",
+        Mark::Type => "font-x-generic",
+        Mark::Terminal => "application-x-executable",
+        Mark::Table => "x-office-spreadsheet",
+        Mark::Presentation => "x-office-presentation",
+        Mark::Symlink => "emblem-symbolic-link",
+        Mark::Themed(_) => unreachable!(),
+    };
+    (Arc::from(name), mark)
+}
+
+#[derive(Clone, Hash, PartialEq, Eq)]
+struct Key {
+    name: Arc<str>,
+    side: u32,
+    alpha: u8,
+}
+#[derive(Clone)]
+enum Raster {
+    Pending,
+    Ready(Arc<RenderImage>),
+    Missing,
+}
+#[derive(Default)]
+struct Cache {
+    entries: HashMap<Key, (u64, Raster)>,
+    clock: u64,
+}
+impl Cache {
+    /// A pending request is never evicted: one job per key, including simultaneous windows.
+    fn request(&mut self, key: &Key) -> (Raster, bool) {
+        self.clock += 1;
+        if let Some((used, raster)) = self.entries.get_mut(key) {
+            *used = self.clock;
+            return (raster.clone(), false);
+        }
+        if self.entries.len() >= MAX_RASTERS {
+            let oldest = self
+                .entries
+                .iter()
+                .filter(|(_, (_, raster))| !matches!(raster, Raster::Pending))
+                .min_by_key(|(_, (used, _))| *used)
+                .map(|(key, _)| key.clone());
+            let Some(oldest) = oldest else {
+                return (Raster::Missing, false);
+            };
+            self.entries.remove(&oldest);
+        }
+        self.entries
+            .insert(key.clone(), (self.clock, Raster::Pending));
+        (Raster::Pending, true)
+    }
+    fn finish(&mut self, key: Key, image: Option<Arc<RenderImage>>) {
+        if let Some((_, raster)) = self.entries.get_mut(&key) {
+            *raster = image.map_or(Raster::Missing, Raster::Ready);
+        }
+    }
+}
+fn cache() -> &'static Mutex<Cache> {
+    static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+    CACHE.get_or_init(Default::default)
+}
+
+fn candidates(name: &str) -> Vec<&str> {
+    let name = if name == "inode-directory" {
+        "folder"
+    } else {
+        name
+    };
+    let generic = match name.split('-').next().unwrap_or("") {
+        "text" => "text-x-generic",
+        "image" => "image-x-generic",
+        "audio" => "audio-x-generic",
+        "video" => "video-x-generic",
+        "font" => "font-x-generic",
+        "application" => "application-x-generic",
+        _ => name,
+    };
+    if generic == name {
+        vec![name]
+    } else {
+        vec![name, generic]
+    }
+}
+
+/// The existing bounded, untrusted SVG/PNG decoder keeps colour rather than making an alpha mask.
+fn load(icons: &Icons, key: &Key, renderer: SvgRenderer) -> Option<Arc<RenderImage>> {
+    for name in candidates(&key.name) {
+        let Some(path) = icons.resolve(name, key.side, 1) else {
+            continue;
+        };
+        if !matches!(
+            path.extension().and_then(|s| s.to_str()),
+            Some("svg" | "png")
+        ) {
+            continue;
+        }
+        let job = pv1::RasterJob {
+            raster: pv1::raster_for_path(&path, renderer.clone()),
+            path,
+            size: (key.side, key.side),
+            epoch: 0,
+            latest: Arc::new(AtomicU64::new(0)),
+        };
+        if let pv1::RasterOutcome::Raster(image) = pv1::raster_run(&job) {
+            return with_alpha(image, key.alpha);
+        }
+    }
+    None
+}
+
+fn with_alpha(image: Arc<RenderImage>, alpha: u8) -> Option<Arc<RenderImage>> {
+    if alpha == 255 {
+        return Some(image);
+    }
+    let size = image.size(0);
+    let mut bytes = image.as_bytes(0)?.to_vec();
+    // RenderImage holds straight BGRA. Do not tint RGB when dimming cut/disabled rows.
+    for pixel in bytes.chunks_exact_mut(4) {
+        pixel[3] = (u16::from(pixel[3]) * u16::from(alpha) / 255) as u8;
+    }
+    RenderImage::from_bgra(size.width.0 as u32, size.height.0 as u32, bytes).map(Arc::new)
+}
+
+pub(super) fn paint(
+    mark: Mark,
+    bounds: Bounds<Pixels>,
+    opacity: f32,
+    window: &mut Window,
+    cx: &App,
+) -> bool {
+    let (name, _) = identity(mark);
+    // Size buckets bound resize churn; 256 device pixels is ample for file marks, including HiDPI.
+    let pixels = (f32::from(bounds.size.width.max(bounds.size.height)) * window.scale_factor())
+        .ceil()
+        .clamp(1., 256.) as u32;
+    let key = Key {
+        name,
+        side: pixels.next_power_of_two().max(16),
+        alpha: (opacity.clamp(0., 1.) * 255.).round() as u8,
+    };
+    let (raster, fresh) = cache().lock().unwrap().request(&key);
+    if fresh {
+        let renderer = cx.svg_renderer();
+        let (done, completion) = async_channel::bounded(1);
+        // Detached work completes its cache entry even if the initiating window/app closes.
+        cx.background_executor()
+            .spawn(async move {
+                static SESSION: OnceLock<Icons> = OnceLock::new();
+                let image = load(SESSION.get_or_init(Icons::session), &key, renderer);
+                cache().lock().unwrap().finish(key, image);
+                let _ = done.try_send(());
+            })
+            .detach();
+        cx.spawn(async move |cx| {
+            let _ = completion.recv().await;
+            cx.update(|cx| cx.refresh_windows());
+        })
+        .detach();
+    }
+    let Raster::Ready(image) = raster else {
+        return false;
+    };
+    let fit = gpui::ObjectFit::Contain.get_bounds(bounds, image.size(0));
+    window
+        .paint_image(bounds, fit, Corners::default(), image, 0, false)
+        .is_ok()
+}
+
+#[cfg(test)]
+#[path = "system_icons_tests.rs"]
+mod tests;
