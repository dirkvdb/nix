diff --git a/src/ui_logic_rail_places/plugin_heading_tests.rs b/src/ui_logic_rail_places/plugin_heading_tests.rs
--- a/src/ui_logic_rail_places/plugin_heading_tests.rs
+++ b/src/ui_logic_rail_places/plugin_heading_tests.rs
@@ -1,1 +1,23 @@
 // Plugin rail headings from board 0402-plugin-rail-mark: a plugin's own title, merged by title, else one PLUGINS.
+#[test]
+fn empty_network_heading_survives_section_pipeline() {
+    use super::order::{rail_sections, Shown};
+    let network = RailSection {
+        heading: Heading::Key("settings.places.network"),
+        rows: Vec::new(),
+    };
+    let sections = rail_sections(
+        &[],
+        Shown::default(),
+        Vec::new(),
+        &[false; 7],
+        vec![network],
+        &[],
+    );
+    let sections = plugin_headings(sections, english);
+    assert!(sections.iter().any(|s| {
+        s.heading == Heading::Key("settings.places.network") && s.rows.is_empty()
+    }));
+    assert!(!sections.iter().any(|s| s.heading == Heading::Key(PLUGINS_HEADING)));
+}
